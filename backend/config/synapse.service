[Unit]
Description=SYNAPSE Backend - FastAPI Application
After=network.target postgresql.service valkey.service qdrant.service
Wants=postgresql.service valkey.service qdrant.service

[Service]
Type=simple
User=de3f4ault
Group=de3f4ault
WorkingDirectory=/home/de3f4ault/Desktop/Projects/synapse/backend

# Environment
Environment="PATH=/home/de3f4ault/Desktop/Projects/synapse/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/de3f4ault/Desktop/Projects/synapse/backend/.env

# Gunicorn command
ExecStart=/home/de3f4ault/.pyenv/shims/gunicorn \
    --config /home/de3f4ault/Desktop/Projects/synapse/backend/config/gunicorn.conf.py \
    app.main:app

# Restart policy
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapse-backend

[Install]
WantedBy=multi-user.target
