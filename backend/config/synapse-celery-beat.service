[Unit]
Description=SYNAPSE Celery Beat - Periodic Task Scheduler
Documentation=https://docs.celeryq.dev/
After=network.target postgresql.service valkey.service synapse.service synapse-celery-worker.service
Wants=postgresql.service valkey.service synapse-celery-worker.service
BindsTo=synapse.service

[Service]
Type=simple
User=de3f4ault
Group=de3f4ault
WorkingDirectory=/home/de3f4ault/Desktop/Projects/synapse/backend

# Environment
Environment="PATH=/home/de3f4ault/Desktop/Projects/synapse/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/de3f4ault/Desktop/Projects/synapse/backend/.env

# Celery beat command
# Manages periodic/scheduled tasks
# Use Python -m celery instead of wrapper script to avoid systemd exec issues
ExecStart=/home/de3f4ault/.pyenv/versions/3.11.14/bin/python3.11 -m celery \
    -A app.services.background.celery_app beat \
    --loglevel=info \
    --pidfile=/tmp/celerybeat.pid \
    --schedule=/home/de3f4ault/Desktop/Projects/synapse/backend/data/celerybeat-schedule.db

# Restart policy
Restart=always
RestartSec=10s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Resource limits
# TasksMax controls how many tasks (threads/processes) service can create
# Setting to infinity to avoid "Resource temporarily unavailable" errors
TasksMax=infinity
LimitNOFILE=65536
LimitNPROC=4096  # Increased from default to allow process forking

# Security hardening (adjusted for user home directory access)
NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=strict - REMOVED: conflicts with user home directory
# ProtectHome=true - REMOVED: we need access to user's data directory
# ReadWritePaths - NOT NEEDED without ProtectSystem
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapse-celery-beat

[Install]
WantedBy=multi-user.target
