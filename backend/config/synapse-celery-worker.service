[Unit]
Description=SYNAPSE Celery Worker - Background Task Processing
Documentation=https://docs.celeryq.dev/
After=network.target postgresql.service valkey.service synapse.service
Wants=postgresql.service valkey.service
BindsTo=synapse.service

[Service]
Type=simple
User=de3f4ault
Group=de3f4ault
WorkingDirectory=/home/de3f4ault/Desktop/Projects/synapse/backend

# Environment
Environment="PATH=/home/de3f4ault/Desktop/Projects/synapse/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/de3f4ault/Desktop/Projects/synapse/backend/.env

# Celery worker command with optimized settings
# Note: Uses prefork pool for CPU-bound tasks (RAG, embeddings, document processing)
ExecStart=/home/de3f4ault/.pyenv/shims/celery \
    -A app.services.background.celery_app worker \
    --pool=prefork \
    --queues=webhook,rag,documents,default \
    --loglevel=info \
    --prefetch-multiplier=1 \
    --max-tasks-per-child=50 \
    --max-memory-per-child=500000 \
    --without-heartbeat \
    --without-gossip \
    --without-mingle \
    --concurrency=4

# Restart policy - critical for background tasks
Restart=always
RestartSec=10s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60s
TimeoutStartSec=30s

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening (adjusted for user home directory access)
NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=strict - REMOVED: conflicts with user home directory
# ProtectHome=true - REMOVED: we need access to user's data directory
# ReadWritePaths - NOT NEEDED without ProtectSystem
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synapse-celery-worker

[Install]
WantedBy=multi-user.target
