# ============================================================================
# SYNAPSE Backend Configuration
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=SYNAPSE
APP_VERSION=1.0.0
ENVIRONMENT=development
# Options: development, testing, production

# ============================================================================
# Database - PostgreSQL
# ============================================================================
DATABASE_URL=postgresql+asyncpg://synapse_user:synapse_pass@localhost:5432/synapse
# Format: postgresql+asyncpg://user:password@host:port/database
# Note: Must use asyncpg driver for async operations

# ============================================================================
# Redis - Caching & Rate Limiting
# ============================================================================
REDIS_URL=redis://localhost:6379/0
# Format: redis://host:port/db_number
# Used for: Caching, rate limiting, token blacklist

# ============================================================================
# Vector Store - LanceDB
# ============================================================================
LANCEDB_PATH=data/lancedb
# Path to LanceDB vector store directory
# Used for: Document embeddings, semantic search

# ============================================================================
# Analytics - DuckDB
# ============================================================================
DUCKDB_PATH=data/duckdb/analytics.duckdb
# Path to DuckDB analytics database file
# Used for: OLAP queries, learning analytics

# ============================================================================
# AI - Google Gemini API
# ============================================================================
GEMINI_API_KEY=AIzaSyDHk5Fel7n-4W2GCsJ-y1PupO4ELk3DReQ
# Get your key from: https://makersuite.google.com/app/apikey
# Used for: AI chat, content generation, quiz creation

# ============================================================================
# Authentication - JWT
# ============================================================================
JWT_SECRET_KEY=8e43858dc91e2060486ba13e78a36127b9ea15f513c4e0476c81d9f8beddb00a
# CRITICAL: Change this in production! Minimum 32 characters.
# Generate secure key: openssl rand -hex 32

JWT_ALGORITHM=HS256
# Options: HS256, HS384, HS512
# Recommended: HS256 for most use cases

JWT_EXPIRATION_MINUTES=60
# Token expiration in minutes
# Recommended: 60 (1 hour) for security

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================================
# JSON array of allowed origins
# Example: ["http://localhost:3000","https://app.synapse.ai"]
# NOTE: Defaults are set in app/core/config.py - only override here if needed

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO for production, DEBUG for development

# ============================================================================
# File Upload
# ============================================================================
UPLOAD_DIR=data/uploads
# Directory for uploaded files
# Ensure this directory exists and has write permissions

MAX_UPLOAD_SIZE=104857600
# Maximum file upload size in BYTES
# Default: 104857600 bytes = 100MB

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
# Enable/disable rate limiting
# Options: true, false

RATE_LIMIT_REQUESTS=100
# Number of requests allowed per window
# Default: 100 requests per window

RATE_LIMIT_WINDOW=60
# Rate limit window in SECONDS
# Default: 60 seconds (1 minute)

# ============================================================================
# Background Tasks
# ============================================================================
BACKGROUND_TASKS_ENABLED=true
# Enable/disable background task processing
# Options: true, false

BACKGROUND_WORKERS=4
# Number of background worker threads
# Recommended: 4 for typical workloads
# ============================================================================
# Webhooks - Event Notifications
# ============================================================================
WEBHOOK_ENCRYPTION_KEY=8cI9MWV8QyqLh7sNn-ehQFUysDagmKMT
# Fernet encryption key for webhook secrets (REQUIRED in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: gAAAAABhqN7... (44 characters, base64-encoded)

WEBHOOK_ENCRYPTION_ROTATION_KEYS=
# Optional: Comma-separated list of old encryption keys for gradual key rotation
# Example: old_key_1,old_key_2,old_key_3
# Leave empty if not rotating keys

WEBHOOK_MAX_RETRIES=5
# Maximum webhook delivery retry attempts
# Default: 5 attempts
# Retry schedule: 2s, 4s, 8s, 16s, 32s (exponential backoff with jitter)

WEBHOOK_BACKOFF_MAX=3600
# Maximum backoff delay in SECONDS between retries
# Default: 3600 seconds (1 hour)

WEBHOOK_TIMEOUT=10
# Webhook HTTP request timeout in SECONDS
# Default: 10 seconds
# Recommended: 10-30 seconds depending on your endpoints
